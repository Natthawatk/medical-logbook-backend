NODE_ENV=development
PORT=5000
DB_MODE=test
MONGODB_URI=mongodb://localhost:27017/medical_logbook
MONGODB_DB_NAME_TEST=medical_logbook_test
MONGODB_DB_NAME_PROD=medical_logbook_prod
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost
# Initial passwords omitted during user creation/import are auto-generated per account (12-char random strong password)

GOOGLE_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
MAIL_USER=your-email@example.com
MAIL_FROM=Medical Logbook <your-email@example.com>
