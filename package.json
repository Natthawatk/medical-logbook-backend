{
  "name": "medical-logbook-backend",
  "version": "1.0.0",
  "description": "Backend API for the Medical Logbook system (Express + MongoDB + Mongoose).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; process.env.DB_MODE='prod'; require('./server.js')\"",
    "dev": "nodemon --delay 5 server.js",
    "dev:prod-db": "node -e \"process.env.DB_MODE='prod'; require('./server.js')\"",
    "db:separate": "node scripts/separateDatabases.js"
  },
  "keywords": [
    "express",
    "mongoose",
    "medical-logbook",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^2.2.12",
    "mongoose": "^8.6.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "resend": "^6.12.4",
    "strip-bom-stream": "^5.0.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
