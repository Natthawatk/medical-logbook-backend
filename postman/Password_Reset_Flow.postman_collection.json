{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7g8h-9i0j-k1l2m3n4o5p6",
		"name": "Medical Logbook v2 - Password Reset Flow",
		"description": "Flow to reset password using OTP for Medical Logbook v2.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Send OTP",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{user_email}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/otp/send",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"otp",
						"send"
					]
				},
				"description": "Sends a 6-digit OTP to the user's email. Note: Check server console or Mailtrap for the code."
			},
			"response": []
		},
		{
			"name": "2. Verify OTP (Optional Test)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{user_email}}\",\n    \"otp\": \"{{otp_code}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/otp/verify",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"otp",
						"verify"
					]
				},
				"description": "Verifies if the OTP is valid. Note: This marks the OTP as used in the current implementation, so reset-password might fail if you run this first unless you request a new OTP."
			},
			"response": []
		},
		{
			"name": "3. Reset Password",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{user_email}}\",\n    \"otp\": \"{{otp_code}}\",\n    \"new_password\": \"{{new_password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/auth/reset-password",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"reset-password"
					]
				},
				"description": "Verifies OTP and updates the user's password."
			},
			"response": []
		},
		{
			"name": "4. Login with New Password",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{user_email}}\",\n    \"password\": \"{{new_password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "Tests if the password was changed correctly by attempting to log in."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "user_email",
			"value": "student@test.com",
			"type": "string"
		},
		{
			"key": "otp_code",
			"value": "123456",
			"type": "string"
		},
		{
			"key": "new_password",
			"value": "newpassword123",
			"type": "string"
		}
	]
}