						"student"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Get Locations",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 200 && jsonData.success && jsonData.data.length > 0) {",
							"    var loc = jsonData.data[0];",
							"    pm.collectionVariables.set(\"location_id\", loc._id);",
							"    pm.collectionVariables.set(\"location_lat\", loc.latitude);",
							"    pm.collectionVariables.set(\"location_lng\", loc.longitude);",
							"    pm.test(\"Location found and variables set\", function () {",
							"        pm.expect(loc._id).to.exist;",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/locations",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"locations"
					]
				}
			},
			"response": []
		},
