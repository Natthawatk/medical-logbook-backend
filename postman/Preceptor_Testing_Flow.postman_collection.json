					]
				}
			},
			"response": []
		},
		{
			"name": "4. Get Pending Logbook Cases",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 200 && jsonData.success && jsonData.data.length > 0) {",
							"    pm.collectionVariables.set(\"case_id\", jsonData.data[0]._id);",
							"    pm.test(\"Found pending case and saved case_id\", function () {",
							"        pm.expect(jsonData.data[0]._id).to.exist;",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token_preceptor}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/logbook-cases/pending",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"logbook-cases",
						"pending"
					]
				}
			},
			"response": []
		},
