{
	"info": {
		"_postman_id": "9c3d5f6a-2b3c-4d5e-6f7g-8h9i0j1k2l3m",
		"name": "Medical Logbook v2 - Preceptor Testing Flow",
		"description": "Comprehensive testing flow for the Preceptor role in Medical Logbook v2.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login (Preceptor)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 200 && jsonData.success && jsonData.data.token) {",
							"    pm.collectionVariables.set(\"bearer_token_preceptor\", jsonData.data.token);",
							"    pm.test(\"Login successful and token saved\", function () {",
							"        pm.expect(jsonData.data.token).to.be.a('string');",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{preceptor_email}}\",\n    \"password\": \"{{preceptor_password}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Get Preceptor Dashboard",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token_preceptor}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
